@inproceedings{yoshida2026colyricist,
    title = {CoLyricist: Enhancing Lyric Writing with AI through Workflow-Aligned Support},
    author = {Yoshida, Masahiro and Li, Bingxuan and Zhao, Songyan and Zhou, Qinyi and Hu, Shiwei and Chen, Xiang 'Anthony and Peng, Nanyun},
    booktitle = {Proceedings of the 31st International Conference on Intelligent User Interfaces},
    pages = {1387--1410},
    year = {2026},
    doi = {10.1145/3742413.3789099},
    selected = {true},
    preview = {colyricist.jpg},
    pdf = {CoLyricist.pdf},
    video = {/assets/video/colyricist.mp4},
    html = {https://doi.org/10.1145/3742413.3789099},
    abstract = {
        CoLyricist is an AI-assisted lyric writing tool designed around the workflows of experienced lyricists. Interviews with 10 lyricists identified four recurring stages: theme setting, ideation, drafting, and melody fitting. The system offers tailored support for brainstorming, drafting, rhyming, and fitting lyrics to a melody while preserving the writer's intended meaning. In an exploratory study with 16 experienced and novice lyricists, participants valued the workflow-aligned support; novices particularly appreciated melody fitting, while experienced lyricists valued the ideation tools.
    }
}

@inproceedings{liu2026overreliance,
    title = {Behavioral Indicators of Overreliance During Interaction with Conversational Language Models},
    author = {Liu, Chang* and Zhou, Qinyi* and Shen, Xinjie and Liu, Xingyu Bruce and Wu, Tongshuang and Chen, Xiang 'Anthony'},
    booktitle = {Proceedings of the 2026 CHI Conference on Human Factors in Computing Systems},
    pages = {1--23},
    year = {2026},
    doi = {10.1145/3772318.3790332},
    selected = {true},
    preview = {overreliance.jpg},
    pdf = {overreliance_CHIpaper_Camera_ready.pdf},
    video = {/assets/video/overreliance.mp4},
    html = {https://doi.org/10.1145/3772318.3790332},
    abstract = {
        Conversational language models can present misinformation in fluent responses, making overreliance difficult to detect from task outcomes alone. We studied interaction logs from 77 participants working across three tasks with an LLM containing plausible misinformation. By encoding and clustering segments of user interactions, we identified behavioral patterns associated with overreliance. Lower overreliance was linked to careful task comprehension and fine-grained navigation; higher overreliance was linked to frequent copy-paste, skipping initial comprehension, repeated LLM references, coarse locating, and accepting misinformation despite hesitation. These findings inform the design of timely interventions during human-AI interaction.
    },
    arxiv = {2602.11567v1}
}

@inproceedings{deng2026lighthouse,
    title = {Lighthouse: A Self-Reconfiguring Sociotechnical Infrastructure for the Unforeseen Long-Tail of Urban Crisis},
    author = {Deng, Ning and Zhou, Qinyi and Zhuo, Yuchao and Xue, Wei and Guo, Yike},
    booktitle = {Proceedings of the Extended Abstracts of the 2026 CHI Conference on Human Factors in Computing Systems},
    pages = {1--6},
    year = {2026},
    doi = {10.1145/3772363.3798644},
    preview = {lighthouse.jpg},
    pdf = {Lighthouse.pdf},
    html = {https://doi.org/10.1145/3772363.3798644},
    abstract = {
        Crisis coordination tools built on fixed categories struggle to keep up with needs that emerge during an unfolding emergency. Lighthouse proposes generative middleware that interprets fragmented, multi-channel messages and creates shared coordination dashboards as needs change. A mixed-initiative stability process keeps people involved in verifying the generated structures. The system also preserves emerging patterns in a living archive, helping communities adapt future crisis taxonomies to observed needs rather than relying solely on predefined categories.
    }
}

@incollection{zhou2026cuby,
    title = {Cuby and His Shadow Friend: A Game-Based STEAM Learning Book for Kids},
    author = {Zhou, Qinyi and Wang, Mengyu and Shi, Yufei and Xu, Zihan and Lai, Yukou},
    booktitle = {Empowering Educational Innovation Through Design: Volume Two},
    publisher = {Springer Nature Singapore},
    pages = {91--109},
    year = {2026},
    doi = {10.1007/978-981-95-4953-5_7},
    selected = {true},
    preview = {cuby.jpg},
    pdf = {Cuby-and-His-Shadow-Friend.pdf},
    html = {https://link.springer.com/chapter/10.1007/978-981-95-4953-5_7},
    abstract = {
        Cuby and His Shadow Friend is a game-based STEAM learning book that introduces light and shadow to children aged 6-9 through parent-child co-reading. Developed with feedback from teachers, researchers, and parents, the book uses tactile, visual, and auditory activities, including a UV lamp that reveals story details and a prism for exploring refraction. User feedback suggests that these multi-sensory features encourage curiosity and understanding, while identifying elements that could be improved for independent use.
    }
}

@inproceedings{zhou2024productmeta,
    title = {ProductMeta: An Interactive System for Metaphorical Product Design Ideation with Multimodal Large Language Models},
    author = {Zhou, Qinyi* and Deng, Jie* and Liu, Yu and Wang, Yun and Xia, Yan and Ou, Yang and Lu, Zhicong and Ma, Sai and Li, Scarlett and Xu, Yingqing},
    booktitle = {Proceedings of the 2025 CHI Conference on Human Factors in Computing Systems},
    pages = {1--24},
    year = {2025},
    doi = {10.1145/3706598.3713935},
    selected = {true},
    preview = {productmeta.jpg},
    pdf = {ProductMeta_1210clear.pdf},
    video = {/assets/video/productmeta.mp4},
    abstract = {
        Product metaphors, which involve creating products that convey meaning through metaphorical associations, are a powerful tool in product design. However, according to our formative study, novice designers often struggle to establish coherent links between target and source, to manage the complexity of diverse mapping possibilities, and to balance product usability with metaphorical expression. To address these challenges, we introduce ProductMeta, a creativity support tool designed to support novice designers in exploring and developing metaphorical product designs. ProductMeta incorporates domain knowledge and decomposes the design process into iterative modules and framework-based interfaces, fostering both divergent and convergent thinking. Through user studies, we demonstrate that ProductMeta enables novice designers to generate diverse and contextually relevant design ideas by facilitating structured exploration. We conclude with design implications for human-AI co-creation.
    },
    html = {https://www.microsoft.com/en-us/research/publication/productmeta-an-interactive-system-for-metaphorical-product-design-ideation-with-multimodal-large-language-models/} 
}


